{
	"name": "omp-statusliney",
	"version": "0.1.0",
	"description": "Fully customizable statusline for Oh My Pi (omp)",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"omp",
		"oh-my-pi",
		"omp-plugin",
		"statusline",
		"pi-package"
	],
	"omp": {
		"description": "Replaces the omp statusline with a configurable multi-line bar",
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md"
	],
	"engines": {
		"bun": ">=1.3.14"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=18.12.2 <19",
		"@oh-my-pi/pi-tui": ">=18.12.2 <19",
		"@oh-my-pi/pi-utils": ">=18.12.2 <19"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		}
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "18.12.2",
		"@oh-my-pi/pi-tui": "18.12.2",
		"@oh-my-pi/pi-utils": "18.12.2",
		"@types/bun": "latest",
		"typescript": "^5.9.0"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	}
}
