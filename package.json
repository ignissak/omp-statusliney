{
  "name": "omp-statusliney",
  "version": "1.0.1",
  "description": "Fully customizable statusline for Oh My Pi (omp)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "statusline",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignissak/omp-statusliney.git"
  },
  "homepage": "https://github.com/ignissak/omp-statusliney#readme",
  "bugs": {
    "url": "https://github.com/ignissak/omp-statusliney/issues"
  },
