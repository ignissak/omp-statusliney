  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.12.2",
    "@oh-my-pi/pi-tui": "18.12.2",
    "@oh-my-pi/pi-utils": "18.12.2",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
